{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memory",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "kv_namespaces": [
    {
      "binding": "DATABASE_WEBSITE",
      "id": "ISI_ID_KV_KAMU"
    }
  ],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.mjs",
        "**/*.js"
      ]
    }
  ]
}